# txs settings
#
# Tool-level configuration for txs behavior.
# Format: key = value (one per line, # for comments)
#
# Available settings:
#   auto_add_clone - Automatically add repos cloned with 'txs clone-bare'
#                    to the project config (true/false, default: true)
#   fzf_height     - Height of fzf picker (default: 50%)
#                    Accepts any value fzf supports: percentage or line count
#   tui_trees_expanded - Expand all TUI tree panels on startup (true/false, default: true)
#   tui_theme          - Textual theme name (default: textual-dark); updated when you pick a theme in the TUI
#   worktree_session_truncate - Shorten worktree session names (true/false, default: true)
#   worktree_session_max_len  - Max length of the worktree part of a session name
#                               (`project/worktree`, default: 24)
#
# For additional fzf customization (colors, keybindings, layout, etc.)
# use the FZF_DEFAULT_OPTS environment variable. See: man fzf

auto_add_clone = true
# fzf_height = 50%
# worktree_session_truncate = true
# worktree_session_max_len = 24
